<?xml version="1.0" encoding="utf-8"?>
<!-- Источники пакетов только для этого решения: унаследованные локальные
     источники из глобального конфига отключаются (ошибки NU1301). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
