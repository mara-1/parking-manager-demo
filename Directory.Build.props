<Project>
  <!-- Общие настройки всех проектов решения -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Статический анализ: анализаторы .NET и правила стиля из .editorconfig -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Версия по умолчанию; при релизе подставляется из git-тега -->
    <Version>0.0.0-dev</Version>
    <Deterministic>true</Deterministic>

    <!-- нужно для работы правила IDE0005 (неиспользуемые using); -->
    <!-- CS1591 (нет XML-комментария) при этом не требуется -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Линтер стиля кода C# -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
